# All settings are optional. The Python side reads them from your shell (export ...).
# The dashboard reads NEXT_PUBLIC_API_URL from frontend/.env.local.

RUBRICSMITH_DATASET=golden_dataset.jsonl
RUBRICSMITH_RUBRIC=rubric.json
RUBRICSMITH_DB=rubricsmith.db

RUBRICSMITH_HOST=127.0.0.1
RUBRICSMITH_PORT=8010
RUBRICSMITH_ALLOWED_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
