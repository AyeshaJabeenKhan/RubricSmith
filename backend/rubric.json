{
  "name": "ParcelPal support bot",
  "pass_threshold": 0.6,
  "plugins": ["plugin_numbers"],
  "metrics": {
    "exact_match":    {"weight": 0.5},
    "keyword_recall": {"weight": 3, "min": 0.5},
    "rouge_l":        {"weight": 3},
    "length_ratio":   {"weight": 1, "params": {"min_ratio": 0.5, "max_ratio": 2.5}},
    "numbers_match":  {"weight": 2, "min": 1.0},
    "no_forbidden":   {"weight": 1, "min": 1.0, "params": {"phrases": ["as an ai language model", "i cannot help"]}}
  }
}
